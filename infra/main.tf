# GCP for audit-agent-evals: the trace archive in GCS, traces in BigQuery, the review API and the nightly
# evaluation on Cloud Run. Region: Frankfurt, data stays in the EU.
#
# Retention mirrors config/traces.yaml: hot BigQuery partitions for 90 days, the Parquet archive for 400 days,
# release evidence in a locked bucket. tests/test_infra.py keeps the numbers and the permissions honest.

terraform {
  required_version = ">= 1.8"
  required_providers {
    google = { source = "hashicorp/google", version = "~> 6.10" }
  }
}

provider "google" {
  project = var.project
  region  = var.region
}

locals {
  labels = { app = "audit-agent-evals", env = var.env }
  tables = toset(["runs", "spans", "findings"])
}

# ------------------------------------------------------------------------------------------- trace archive

resource "google_storage_bucket" "archive" {
  name                        = "${var.project}-aae-archive-${var.env}"
  location                    = var.region
  uniform_bucket_level_access = true
  public_access_prevention    = "enforced"
  labels                      = local.labels

  lifecycle_rule {
    condition { age = 30 }
    action {
      type          = "SetStorageClass"
      storage_class = "NEARLINE"
    }
  }
  lifecycle_rule {
    condition { age = 120 }
    action {
      type          = "SetStorageClass"
      storage_class = "COLDLINE"
    }
  }
  lifecycle_rule {
    condition { age = var.archive_keep_days }
    action { type = "Delete" }
  }
}

# Runs a release decision rests on are copied here and cannot be deleted before the retention period ends.
resource "google_storage_bucket" "evidence" {
  name                        = "${var.project}-aae-evidence-${var.env}"
  location                    = var.region
  uniform_bucket_level_access = true
  public_access_prevention    = "enforced"
  labels                      = local.labels

  retention_policy {
    retention_period = var.evidence_retention_days * 86400
    is_locked        = var.env == "prod"
  }
}

# ------------------------------------------------------------------------------------------------ BigQuery

resource "google_bigquery_dataset" "traces" {
  dataset_id  = "aae_traces_${var.env}"
  location    = "EU"
  description = "Agent evaluation traces: runs, spans, findings. Schemas generated by `aae schema`."
  labels      = local.labels
}

resource "google_bigquery_table" "hot" {
  for_each            = local.tables
  dataset_id          = google_bigquery_dataset.traces.dataset_id
  table_id            = each.key
  schema              = file("${path.module}/bigquery/${each.key}.json")
  deletion_protection = var.env == "prod"
  clustering          = ["agent", "split"]
  labels              = local.labels

  time_partitioning {
    type          = "DAY"
    field         = "day"
    expiration_ms = var.hot_days * 86400000
  }
  require_partition_filter = true
}

# The whole archive stays queryable without loading it: an external table over the Parquet files.
resource "google_bigquery_table" "archive" {
  for_each            = local.tables
  dataset_id          = google_bigquery_dataset.traces.dataset_id
  table_id            = "archive_${each.key}"
  deletion_protection = false
  labels              = local.labels

  external_data_configuration {
    source_format = "PARQUET"
    autodetect    = true
    source_uris   = ["gs://${google_storage_bucket.archive.name}/dt=*/${each.key}.parquet"]
    hive_partitioning_options {
      mode              = "CUSTOM"
      source_uri_prefix = "gs://${google_storage_bucket.archive.name}/{dt:DATE}"
    }
  }
}

# ------------------------------------------------------------------------------------------ identities

# The evaluation job writes runs; it can add objects to the archive but cannot overwrite or delete them.
resource "google_service_account" "evaluator" {
  account_id   = "aae-evaluator-${var.env}"
  display_name = "audit-agent-evals evaluation job"
}

# The review API reads results and records labels; it never writes traces.
resource "google_service_account" "api" {
  account_id   = "aae-api-${var.env}"
  display_name = "audit-agent-evals review API"
}

resource "google_storage_bucket_iam_member" "evaluator_archive_create" {
  bucket = google_storage_bucket.archive.name
  role   = "roles/storage.objectCreator"
  member = "serviceAccount:${google_service_account.evaluator.email}"
}

resource "google_storage_bucket_iam_member" "evaluator_archive_read" {
  bucket = google_storage_bucket.archive.name
  role   = "roles/storage.objectViewer"
  member = "serviceAccount:${google_service_account.evaluator.email}"
}

resource "google_storage_bucket_iam_member" "evaluator_evidence_create" {
  bucket = google_storage_bucket.evidence.name
  role   = "roles/storage.objectCreator"
  member = "serviceAccount:${google_service_account.evaluator.email}"
}

resource "google_bigquery_dataset_iam_member" "evaluator_write" {
  dataset_id = google_bigquery_dataset.traces.dataset_id
  role       = "roles/bigquery.dataEditor"
  member     = "serviceAccount:${google_service_account.evaluator.email}"
}

resource "google_project_iam_member" "evaluator_jobs" {
  project = var.project
  role    = "roles/bigquery.jobUser"
  member  = "serviceAccount:${google_service_account.evaluator.email}"
}

resource "google_bigquery_dataset_iam_member" "api_read" {
  dataset_id = google_bigquery_dataset.traces.dataset_id
  role       = "roles/bigquery.dataViewer"
  member     = "serviceAccount:${google_service_account.api.email}"
}

resource "google_project_iam_member" "api_jobs" {
  project = var.project
  role    = "roles/bigquery.jobUser"
  member  = "serviceAccount:${google_service_account.api.email}"
}

resource "google_storage_bucket_iam_member" "api_archive_read" {
  bucket = google_storage_bucket.archive.name
  role   = "roles/storage.objectViewer"
  member = "serviceAccount:${google_service_account.api.email}"
}

# Only the evaluation job may call the model (agents under test and the judge).
resource "google_secret_manager_secret" "anthropic" {
  secret_id = "aae-anthropic-api-key-${var.env}"
  labels    = local.labels
  replication {
    user_managed {
      replicas { location = var.region }
    }
  }
}

resource "google_secret_manager_secret_iam_member" "evaluator_secret" {
  secret_id = google_secret_manager_secret.anthropic.id
  role      = "roles/secretmanager.secretAccessor"
  member    = "serviceAccount:${google_service_account.evaluator.email}"
}

# -------------------------------------------------------------------------------------------- Cloud Run

resource "google_cloud_run_v2_service" "api" {
  name     = "aae-api-${var.env}"
  location = var.region
  ingress  = "INGRESS_TRAFFIC_INTERNAL_LOAD_BALANCER"
  labels   = local.labels

  template {
    service_account = google_service_account.api.email
    scaling {
      min_instance_count = 0
      max_instance_count = 3
    }
    containers {
      image   = var.image
      command = ["aae", "serve", "--host", "0.0.0.0", "--port", "8080"]
      ports { container_port = 8080 }
      resources {
        limits = { cpu = "1", memory = "1Gi" }
      }
    }
  }
}

resource "google_cloud_run_v2_job" "nightly_eval" {
  name     = "aae-nightly-eval-${var.env}"
  location = var.region
  labels   = local.labels

  template {
    template {
      service_account = google_service_account.evaluator.email
      timeout         = "3600s"
      max_retries     = 1
      containers {
        image   = var.image
        command = ["sh", "-c", "aae eval ${var.production_agent} --split test && aae traces load"]
        resources {
          limits = { cpu = "4", memory = "4Gi" }
        }
        env {
          name = "ANTHROPIC_API_KEY"
          value_source {
            secret_key_ref {
              secret  = google_secret_manager_secret.anthropic.secret_id
              version = "latest"
            }
          }
        }
      }
    }
  }
}

resource "google_cloud_scheduler_job" "nightly" {
  name      = "aae-nightly-eval-${var.env}"
  region    = var.region
  schedule  = "17 2 * * *"
  time_zone = "Europe/Berlin"

  http_target {
    http_method = "POST"
    uri         = "https://${var.region}-run.googleapis.com/apis/run.googleapis.com/v1/namespaces/${var.project}/jobs/${google_cloud_run_v2_job.nightly_eval.name}:run"
    oauth_token {
      service_account_email = google_service_account.evaluator.email
    }
  }
}
